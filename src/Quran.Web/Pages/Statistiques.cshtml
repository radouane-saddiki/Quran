@page
@model StatistiquesModel
@{
    ViewData["Title"] = L["nav.stats"];
    ViewData["Nav"] = "stats";
    var sum = Model.Summary;
    var sc = Model.ScopeStats;
    string F(double v, string f = "N0") => L.N(v, f);
    string VerseLink(int s, int v) => $"/?mode=sourate&n={s}&hl={s}:{v}#v{s}-{v}";
}

<section class="stats-head">
    <div>
        <h1>@(Model.Scope is null ? L["stats.title"] : L.F("stats.title.surah", L.SurahName(Model.Scope), Model.Scope.Number))</h1>
        @if (Model.Scope is not null)
        {
            <p class="muted">@Model.Scope.Number · @(L.IsAr ? Model.Scope.NameEn : Model.Scope.NameAr) · <a href="/?mode=sourate&n=@Model.Scope.Number">@L["stats.readSurah"]</a></p>
        }
        else
        {
            <p class="muted">@L["stats.subtitle"]</p>
        }
    </div>
    <form method="get" class="picker">
        <input type="hidden" name="form" value="@Model.Form" />
        <input type="hidden" name="top" value="@Model.Top" />
        <label>@L["scope"]
            <select name="surah" data-autosubmit>
                <option value="">@L["whole"]</option>
                @foreach (var s in Model.Corpus.Surahs)
                {
                    <option value="@s.Number" selected="@(Model.Surah == s.Number)">@L.SurahOption(s)</option>
                }
            </select>
        </label>
    </form>
</section>

<section class="tiles">
    @if (sc is null)
    {
        <div class="tile"><span class="tile-value">@F(sum.Surahs)</span><span class="tile-label">@L["stats.surahs"]</span></div>
        <div class="tile"><span class="tile-value">@F(sum.Verses)</span><span class="tile-label">@L["stats.verses"]</span></div>
        <div class="tile"><span class="tile-value">@F(sum.Words)</span><span class="tile-label">@L["stats.words"]</span></div>
        <div class="tile"><span class="tile-value">@F(sum.Letters)</span><span class="tile-label">@L["stats.letters"]</span></div>
        <div class="tile"><span class="tile-value">@F(sum.DistinctWordsNormalized)</span><span class="tile-label">@L.F("stats.distinct", L.FormShort(TextForm.Normalized))</span></div>
        <div class="tile"><span class="tile-value" dir="ltr">@sum.Juz · @sum.Hizb · @sum.Pages</span><span class="tile-label">@L["stats.divisions"]</span></div>
    }
    else
    {
        <div class="tile"><span class="tile-value">@F(sc.Verses)</span><span class="tile-label">@L["stats.verses"]</span></div>
        <div class="tile"><span class="tile-value">@F(sc.Words)</span><span class="tile-label">@L["stats.words"]</span></div>
        <div class="tile"><span class="tile-value">@F(sc.Letters)</span><span class="tile-label">@L["stats.letters"]</span></div>
        <div class="tile"><span class="tile-value">@F(Model.DistinctWords)</span><span class="tile-label">@L.F("stats.distinct", L.FormShort(Model.Form))</span></div>
        <div class="tile"><span class="tile-value">@F(sc.AvgWordsPerVerse, "0.00")</span><span class="tile-label">@L["stats.wordsPerVerse"]</span></div>
        <div class="tile"><span class="tile-value" dir="ltr">@sc.FirstPage–@sc.LastPage</span><span class="tile-label">@L.F("stats.pagesJuz", sc.FirstJuz)</span></div>
    }
</section>

@foreach (var c in Model.Charts)
{
    <partial name="_BarChart" model="c" />
}

<div class="two-col">
    <section>
        <partial name="_BarChart" model="Model.Letters" />
    </section>

    <section>
        <h2>@L["stats.topWords"]</h2>
        <form method="get" class="picker inline">
            @if (Model.Surah is not null) { <input type="hidden" name="surah" value="@Model.Surah" /> }
            <label>@L["stats.form"]
                <select name="form" data-autosubmit>
                    @foreach (var v in RechercheModel.Forms)
                    {
                        <option value="@v" selected="@(Model.Form == v)">@L.FormLabel(v)</option>
                    }
                </select>
            </label>
            <label>@L["stats.minLetters"]
                <select name="minLetters" data-autosubmit>
                    @for (var i = 1; i <= 6; i++)
                    {
                        <option value="@i" selected="@(Model.MinLetters == i)">@i</option>
                    }
                </select>
            </label>
            <label>@L["stats.count"]
                <select name="top" data-autosubmit>
                    @foreach (var t in new[] { 20, 50, 100, 200, 500 })
                    {
                        <option value="@t" selected="@(Model.Top == t)">@t</option>
                    }
                </select>
            </label>
        </form>
        <p class="muted">@L.F("stats.wordsCounted", Model.Words.Total, Model.Words.Distinct)</p>
        <div class="table-wrap">
            <table class="data sortable">
                <thead><tr><th class="num">@L["stats.col.rank"]</th><th>@L["stats.col.word"]</th><th class="num">@L["stats.col.occ"]</th><th class="num">%</th></tr></thead>
                <tbody>
                    @foreach (var w in Model.Words.Items)
                    {
                        <tr>
                            <td class="num">@w.Rank</td>
                            <td class="ar"><a href="/Recherche?q=@Uri.EscapeDataString(w.Value)&form=@Model.Form@(Model.Surah is null ? "" : $"&surah={Model.Surah}")">@w.Value</a></td>
                            <td class="num" data-v="@w.Count">@F(w.Count)</td>
                            <td class="num" data-v="@w.Percent.ToString(System.Globalization.CultureInfo.InvariantCulture)">@F(w.Percent, "0.00")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@if (Model.Scope is null)
{
    var ex = Model.Extremes;
    <section>
        <h2>@L["stats.extremes"]</h2>
        <div class="extremes">
            <div><span class="muted">@L["stats.longestSurah"]</span><a href="/Statistiques?surah=@ex.LongestSurahByVerses.Number">@L.SurahName(ex.LongestSurahByVerses.Number, ex.LongestSurahByVerses.NameAr, ex.LongestSurahByVerses.NameEn)</a> <span>@L.F("stats.nVerses", ex.LongestSurahByVerses.Value)</span></div>
            <div><span class="muted">@L["stats.shortestSurah"]</span><a href="/Statistiques?surah=@ex.ShortestSurahByVerses.Number">@L.SurahName(ex.ShortestSurahByVerses.Number, ex.ShortestSurahByVerses.NameAr, ex.ShortestSurahByVerses.NameEn)</a> <span>@L.F("stats.nVerses", ex.ShortestSurahByVerses.Value)</span></div>
            <div><span class="muted">@L["stats.longestVerse"]</span><a href="@VerseLink(ex.LongestVerseByWords.Surah, ex.LongestVerseByWords.Verse)" dir="ltr">@ex.LongestVerseByWords.Surah:@ex.LongestVerseByWords.Verse</a> <span>@L.F("stats.nWords", ex.LongestVerseByWords.Words)</span></div>
            <div><span class="muted">@L["stats.shortestVerse"]</span><a href="@VerseLink(ex.ShortestVerseByLetters.Surah, ex.ShortestVerseByLetters.Verse)" dir="ltr">@ex.ShortestVerseByLetters.Surah:@ex.ShortestVerseByLetters.Verse</a> <span>@L.F("stats.nLetters", ex.ShortestVerseByLetters.Letters)</span></div>
        </div>
    </section>

    <section>
        <h2>@L["stats.bySurah"]</h2>
        <p class="muted">@L["stats.sortHint"]</p>
        <div class="table-wrap">
            <table class="data sortable">
                <thead>
                    <tr>
                        <th class="num">@L["stats.col.no"]</th><th>@L["stats.col.name"]</th><th>@L["stats.col.name2"]</th>
                        <th class="num">@L["stats.col.verses"]</th><th class="num">@L["stats.col.words"]</th><th class="num">@L["stats.col.letters"]</th>
                        <th class="num">@L["stats.col.wpv"]</th><th class="num">@L["stats.col.pages"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.SurahTable)
                    {
                        <tr>
                            <td class="num" data-v="@s.Number">@s.Number</td>
                            <td class="@(L.IsAr ? "ar" : "")"><a href="/Statistiques?surah=@s.Number">@L.SurahName(s.Number, s.NameAr, s.NameEn)</a></td>
                            <td class="@(L.IsAr ? "" : "ar")"><a href="/?mode=sourate&n=@s.Number">@(L.IsAr ? s.NameEn : s.NameAr)</a></td>
                            <td class="num" data-v="@s.Verses">@F(s.Verses)</td>
                            <td class="num" data-v="@s.Words">@F(s.Words)</td>
                            <td class="num" data-v="@s.Letters">@F(s.Letters)</td>
                            <td class="num" data-v="@s.AvgWordsPerVerse.ToString(System.Globalization.CultureInfo.InvariantCulture)">@F(s.AvgWordsPerVerse, "0.00")</td>
                            <td class="num" data-v="@s.FirstPage" dir="ltr">@s.FirstPage–@s.LastPage</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

<section>
    <h2>@L["stats.exports"]</h2>
    <p class="exports">
        <a class="btn" href="/export/sourates.csv">@L["stats.exp.surahs"]</a>
        <a class="btn" href="/export/juz.csv">@L["stats.exp.juz"]</a>
        <a class="btn" href="/export/hizb.csv">@L["stats.exp.hizb"]</a>
        <a class="btn" href="/export/pages.csv">@L["stats.exp.pages"]</a>
        <a class="btn" href="/export/lettres.csv">@L["stats.exp.letters"]</a>
        <a class="btn" href="/export/mots.csv">@L["stats.exp.words"]</a>
    </p>
</section>
