@page
@model RechercheModel
@{
    ViewData["Title"] = "Recherche";
    ViewData["Nav"] = "recherche";
    var r = Model.Result;
    string N(int n) => n.ToString("N0", BarChart.Fr).Replace(' ', ' ').Replace(' ', ' ');
}

<h1>Recherche</h1>

<form method="get" class="search-form">
    <div class="search-main">
        <input type="search" name="q" value="@Model.Q" placeholder="ex. الله, رحم, بسم الله" dir="rtl" lang="ar" class="quran-input" autofocus aria-label="Mot ou expression" />
        <button type="submit" class="primary">Rechercher</button>
    </div>
    <div class="search-options">
        <label>Correspondance
            <select name="match">
                @foreach (var (v, l) in RechercheModel.Matches)
                {
                    <option value="@v" selected="@(Model.Match == v)">@l</option>
                }
            </select>
        </label>
        <label>Forme du texte
            <select name="form">
                @foreach (var (v, l) in RechercheModel.Forms)
                {
                    <option value="@v" selected="@(Model.Form == v)">@l</option>
                }
            </select>
        </label>
        <label>Portée
            <select name="surah">
                <option value="">Tout le Coran</option>
                @foreach (var s in Model.Corpus.Surahs)
                {
                    <option value="@s.Number" selected="@(Model.Surah == s.Number)">@s.Number. @s.NameEn — @s.NameAr</option>
                }
            </select>
        </label>
    </div>
    <p class="hint">
        La requête est ramenée à la même forme que le texte : « <span class="ar">الله</span> » trouve « <span class="quran">اَ۬للَّهُ</span> ».
        Plusieurs mots = expression (mots consécutifs). La recherche porte sur l'écriture, pas sur les racines :
        utilisez « Commence par » ou « Contient » pour une famille de mots.
    </p>
</form>

@if (Model.Error is not null)
{
    <p class="alert">@Model.Error</p>
}

@if (r is not null)
{
    <section class="tiles">
        <div class="tile"><span class="tile-value">@N(r.TotalOccurrences)</span><span class="tile-label">occurrences</span></div>
        <div class="tile"><span class="tile-value">@N(r.VersesMatched)</span><span class="tile-label">versets</span></div>
        <div class="tile"><span class="tile-value">@N(r.SurahsMatched)</span><span class="tile-label">sourates</span></div>
        <div class="tile"><span class="tile-value ar" dir="rtl">@r.QueryInForm</span><span class="tile-label">forme cherchée</span></div>
    </section>

    @if (Model.Surah is not null)
    {
        var s = Model.Corpus.GetSurah(Model.Surah.Value)!;
        <p class="muted">Limité à la sourate @s.Number (@s.NameEn). <a href="@Model.QueryUrl(surah: null, page: 1)">Chercher dans tout le Coran</a></p>
    }

    @if (Model.Distribution is not null)
    {
        <partial name="_BarChart" model="Model.Distribution" />
    }

    @if (r.TotalOccurrences == 0)
    {
        <p class="empty">Aucun résultat. Essayez « Commence par » ou « Contient », ou la forme « Normalisé ».</p>
    }
    else
    {
        <p class="muted">
            Occurrences @N((Model.PageNumber - 1) * RechercheModel.PageSize + 1)–@N(Math.Min(r.TotalOccurrences, Model.PageNumber * RechercheModel.PageSize))
            sur @N(r.TotalOccurrences)
        </p>
        <ol class="results">
            @foreach (var (v, marks) in Model.Hits)
            {
                var surah = Model.Corpus.GetSurah(v.Surah)!;
                <li>
                    <div class="result-ref">
                        <a href="/?mode=sourate&n=@v.Surah&hl=@v.Reference#v@(v.Surah)-@(v.Number)">@v.Reference</a>
                        <span class="muted">@surah.NameEn — @surah.NameAr · Juz @v.Juz · Hizb @v.Hizb · Page @v.Page</span>
                    </div>
                    <p class="quran result-text" dir="rtl" lang="ar">
                        @for (var i = 0; i < v.Words.Count; i++)
                        {
                            if (marks.Contains(i + 1))
                            {
                                <mark>@v.Words[i].Original</mark>
                            }
                            else
                            {
                                @v.Words[i].Original
                            }
                            @(" ")
                        }
                        <span class="num">@v.NumberGlyph</span>
                    </p>
                </li>
            }
        </ol>

        @if (Model.PageCount > 1)
        {
            <nav class="pager">
                @if (Model.PageNumber > 1)
                {
                    <a class="btn" href="@Model.QueryUrl(page: Model.PageNumber - 1)">‹ Précédent</a>
                }
                else { <span></span> }
                <span class="muted">Page @Model.PageNumber / @Model.PageCount</span>
                @if (Model.PageNumber < Model.PageCount)
                {
                    <a class="btn" href="@Model.QueryUrl(page: Model.PageNumber + 1)">Suivant ›</a>
                }
                else { <span></span> }
            </nav>
        }
    }
}
