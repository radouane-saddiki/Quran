@page
@model RechercheModel
@{
    ViewData["Title"] = L["search.title"];
    ViewData["Nav"] = "recherche";
    var r = Model.Result;
    string N(int n) => L.N(n);
}

<h1>@L["search.title"]</h1>

<form method="get" class="search-form">
    <div class="search-main">
        <input type="search" name="q" value="@Model.Q" placeholder="@L["search.placeholder"]" dir="rtl" lang="ar" class="quran-input" autofocus aria-label="@L["search.aria"]" />
        <button type="submit" class="primary">@L["search.submit"]</button>
    </div>
    <div class="search-options">
        <label>@L["search.match"]
            <select name="match">
                @foreach (var v in RechercheModel.Matches)
                {
                    <option value="@v" selected="@(Model.Match == v)">@L.MatchLabel(v)</option>
                }
            </select>
        </label>
        <label>@L["search.form"]
            <select name="form">
                @foreach (var v in RechercheModel.Forms)
                {
                    <option value="@v" selected="@(Model.Form == v)">@L.FormLabel(v)</option>
                }
            </select>
        </label>
        <label>@L["scope"]
            <select name="surah">
                <option value="">@L["whole"]</option>
                @foreach (var s in Model.Corpus.Surahs)
                {
                    <option value="@s.Number" selected="@(Model.Surah == s.Number)">@L.SurahOption(s)</option>
                }
            </select>
        </label>
    </div>
    @* Textes de traduction statiques : l'insertion HTML est sûre. *@
    <p class="hint">@Html.Raw(L.F("search.hint", "<span class=\"ar\">الله</span>", "<span class=\"quran\">اَ۬للَّهُ</span>"))</p>
</form>

@if (Model.Error is not null)
{
    <p class="alert">@Model.Error</p>
}

@if (r is not null)
{
    <section class="tiles">
        <div class="tile"><span class="tile-value">@N(r.TotalOccurrences)</span><span class="tile-label">@L["search.occurrences"]</span></div>
        <div class="tile"><span class="tile-value">@N(r.VersesMatched)</span><span class="tile-label">@L["search.verses"]</span></div>
        <div class="tile"><span class="tile-value">@N(r.SurahsMatched)</span><span class="tile-label">@L["search.surahs"]</span></div>
        <div class="tile"><span class="tile-value ar" dir="rtl">@r.QueryInForm</span><span class="tile-label">@L["search.searchedForm"]</span></div>
    </section>

    @if (Model.Surah is not null)
    {
        var s = Model.Corpus.GetSurah(Model.Surah.Value)!;
        <p class="muted">@L.F("search.limited", L.SurahName(s), s.Number) <a href="@Model.QueryUrl(surah: null, page: 1)">@L["search.everywhere"]</a></p>
    }

    @if (Model.Distribution is not null)
    {
        <partial name="_BarChart" model="Model.Distribution" />
    }

    @if (r.TotalOccurrences == 0)
    {
        <p class="empty">@L["search.none"]</p>
    }
    else
    {
        <p class="muted">
            @L.F("search.range", (Model.PageNumber - 1) * RechercheModel.PageSize + 1, Math.Min(r.TotalOccurrences, Model.PageNumber * RechercheModel.PageSize), r.TotalOccurrences)
        </p>
        <ol class="results">
            @foreach (var (v, marks) in Model.Hits)
            {
                var surah = Model.Corpus.GetSurah(v.Surah)!;
                <li>
                    <div class="result-ref">
                        <a href="/?mode=sourate&n=@v.Surah&hl=@v.Reference#v@(v.Surah)-@(v.Number)" dir="ltr">@v.Reference</a>
                        <span class="muted">@L.SurahName(surah) · @L["juz"] @v.Juz · @L["hizb"] @v.Hizb · @L["page"] @v.Page</span>
                    </div>
                    <p class="quran result-text" dir="rtl" lang="ar">
                        @for (var i = 0; i < v.Words.Count; i++)
                        {
                            if (marks.Contains(i + 1))
                            {
                                <mark>@v.Words[i].Original</mark>
                            }
                            else
                            {
                                @v.Words[i].Original
                            }
                            @(" ")
                        }
                        <span class="num">@v.NumberGlyph</span>
                    </p>
                </li>
            }
        </ol>

        @if (Model.PageCount > 1)
        {
            <nav class="pager">
                @if (Model.PageNumber > 1)
                {
                    <a class="btn" href="@Model.QueryUrl(page: Model.PageNumber - 1)">@L["prev"]</a>
                }
                else { <span></span> }
                <span class="muted">@L.F("search.page", Model.PageNumber, Model.PageCount)</span>
                @if (Model.PageNumber < Model.PageCount)
                {
                    <a class="btn" href="@Model.QueryUrl(page: Model.PageNumber + 1)">@L["next"]</a>
                }
                else { <span></span> }
            </nav>
        }
    }
}
