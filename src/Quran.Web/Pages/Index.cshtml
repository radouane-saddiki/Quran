@page
@model IndexModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["Nav"] = "lecture";
}

<section class="toolbar" aria-label="@L["read.choose"]">
    <form method="get" class="picker">
        <input type="hidden" name="mode" value="sourate" />
        @if (Model.Vue == "liste") { <input type="hidden" name="vue" value="liste" /> }
        <label>@L["surah"]
            <select name="n" data-autosubmit>
                @if (Model.Mode != "sourate") { <option value="" selected>—</option> }
                @foreach (var s in Model.Corpus.Surahs)
                {
                    <option value="@s.Number" selected="@(Model.Mode == "sourate" && Model.N == s.Number)">@L.SurahOption(s)</option>
                }
            </select>
        </label>
    </form>
    <form method="get" class="picker">
        <input type="hidden" name="mode" value="juz" />
        @if (Model.Vue == "liste") { <input type="hidden" name="vue" value="liste" /> }
        <label>@L["juz"]
            <select name="n" data-autosubmit>
                @if (Model.Mode != "juz") { <option value="" selected>—</option> }
                @for (var i = 1; i <= 30; i++)
                {
                    <option value="@i" selected="@(Model.Mode == "juz" && Model.N == i)">@i</option>
                }
            </select>
        </label>
    </form>
    <form method="get" class="picker">
        <input type="hidden" name="mode" value="hizb" />
        @if (Model.Vue == "liste") { <input type="hidden" name="vue" value="liste" /> }
        <label>@L["hizb"]
            <select name="n" data-autosubmit>
                @if (Model.Mode != "hizb") { <option value="" selected>—</option> }
                @for (var i = 1; i <= 60; i++)
                {
                    <option value="@i" selected="@(Model.Mode == "hizb" && Model.N == i)">@i</option>
                }
            </select>
        </label>
    </form>
    <form method="get" class="picker">
        <input type="hidden" name="mode" value="page" />
        @if (Model.Vue == "liste") { <input type="hidden" name="vue" value="liste" /> }
        <label>@L["page"]
            <input type="number" name="n" min="1" max="604" value="@(Model.Mode == "page" ? Model.N : null)" placeholder="1–604" dir="ltr" />
        </label>
        <button type="submit">@L["read.ok"]</button>
    </form>
    <form method="get" class="picker">
        <label>@L["verse"]
            <input type="text" name="aller" placeholder="@L["read.goto.placeholder"]" size="7" value="@Model.Aller" dir="ltr" />
        </label>
        <button type="submit">@L["read.go"]</button>
    </form>
</section>

@if (Model.Error is not null)
{
    <p class="alert">@Model.Error</p>
}

<section class="reader-head">
    <div>
        <h1>@Model.Heading</h1>
        <p class="muted">@Model.SubHeading</p>
    </div>
    <div class="reader-tools">
        @if (Model.Reciters.Count > 0)
        {
            <button type="button" class="btn primary" id="listen-btn" title="@L["read.listen.title"]">@L["read.listen"]</button>
        }
        <a class="btn" href="@Model.ToggleViewUrl()">@(Model.Vue == "liste" ? L["read.view.mushaf"] : L["read.view.list"])</a>
        <span class="size-ctl" role="group" aria-label="@L["read.size"]">
            <button type="button" data-font="-1" title="@L["read.smaller"]">A−</button>
            <button type="button" data-font="1" title="@L["read.bigger"]">A+</button>
        </span>
    </div>
</section>

<nav class="pager">
    @if (Model.N > 1)
    {
        <a class="btn" href="@Model.LinkTo(Model.Mode, Model.N - 1)">@L["prev"]</a>
    }
    else { <span></span> }
    @if (Model.N < Model.Max)
    {
        <a class="btn" href="@Model.LinkTo(Model.Mode, Model.N + 1)">@L["next"]</a>
    }
</nav>

<article class="reader @(Model.Vue == "liste" ? "reader-list" : "reader-flow")" id="reader">
    @foreach (var (surah, verses) in Model.Segments)
    {
        @if (verses[0].Number == 1)
        {
            <header class="surah-head">
                <div class="surah-title quran">سُورَةُ @surah.NameAr</div>
                <div class="surah-meta">@L.F("read.surah.meta", surah.Number, L.IsAr ? surah.NameEn : surah.NameAr, surah.VerseCount)</div>
                @if (surah.Number != 9)
                {
                    <div class="basmala quran">@QuranCorpus.Basmala</div>
                }
            </header>
        }
        else if (Model.Mode != "sourate")
        {
            <div class="surah-cont">@surah.Number · @L.SurahName(surah) @L["read.cont"]</div>
        }

        <div class="quran verses" dir="rtl" lang="ar">
            @foreach (var v in verses)
            {
                var hl = Model.Hl == v.Reference;
                var title = L.F("read.verse.title", v.Reference, v.Juz, v.Hizb, v.Page) + (v.IsSajda ? " · " + L["read.sajda"] : "");
                <span class="aya @(hl ? "hl" : "") @(v.IsSajda ? "sajda" : "")" id="@IndexModel.Anchor(v)" data-s="@v.Surah" data-v="@v.Number" title="@title">
                    @if (Model.Vue == "liste")
                    {
                        <a class="ref" href="@Model.LinkTo("sourate", v.Surah, v.Reference)" dir="ltr">@v.Reference</a>
                    }
                    @v.Text <span class="num" role="button" tabindex="0" title="@L.F("read.listen.verse", v.Reference)">@v.NumberGlyph</span>
                </span>
            }
        </div>
    }
</article>

@if (Model.Reciters.Count > 0)
{
    <div class="player" id="player" role="region" aria-label="@L["pl.region"]" data-i18n="@L.PlayerJson()" hidden>
        <select id="pl-reciter" aria-label="@L["pl.reciter"]">
            @foreach (var r in Model.Reciters)
            {
                <option value="@r.Id">@(L.IsAr ? r.NameAr : $"{r.Name} — {r.NameAr}")</option>
            }
        </select>
        <div class="pl-buttons">
            <button type="button" id="pl-prev" title="@L["pl.prevVerse"]" aria-label="@L["pl.prevVerse"]">⏮</button>
            <button type="button" id="pl-play" class="primary" title="@L["pl.playPause"]" aria-label="@L["pl.play"]">▶</button>
            <button type="button" id="pl-next" title="@L["pl.nextVerse"]" aria-label="@L["pl.nextVerse"]">⏭</button>
            <button type="button" id="pl-repeat" title="@L["pl.repeat"]" aria-label="@L["pl.repeat"]" aria-pressed="false">🔁</button>
            <select id="pl-speed" aria-label="@L["pl.speed"]" title="@L["pl.speed"]">
                <option value="0.75">0.75×</option>
                <option value="1" selected>1×</option>
                <option value="1.25">1.25×</option>
                <option value="1.5">1.5×</option>
            </select>
        </div>
        <span class="pl-status" id="pl-status" aria-live="polite">@L["pl.hint"]</span>
        <audio id="pl-audio" preload="none"></audio>
    </div>
}

<nav class="pager">
    @if (Model.N > 1)
    {
        <a class="btn" href="@Model.LinkTo(Model.Mode, Model.N - 1)">@L["prev"]</a>
    }
    else { <span></span> }
    @if (Model.N < Model.Max)
    {
        <a class="btn" href="@Model.LinkTo(Model.Mode, Model.N + 1)">@L["next"]</a>
    }
</nav>

@section Scripts {
    <script src="~/js/player.js" asp-append-version="true"></script>
}
